# Webessy Studios: settings for the web server at Hostinger (it reads this file).

# Always the secure address. A visit to an http:// address is sent on, for good (301), to the
# same page at https://, so every page and form travels encrypted. The second condition stops a
# loop if a CDN or proxy in front of the server has already taken the visit over https.
# No HSTS yet, on purpose.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# A page that doesn't exist shows our own 404 page, and still answers "404 Not Found".
ErrorDocument 404 /404.html

# The working notes (RATES.md and the other .md files) and the .zip files never belong
# online. If one is uploaded by mistake, the server answers "not found" instead of showing it.
<IfModule mod_alias.c>
  RedirectMatch 404 (?i)\.(md|zip)$
</IfModule>

# Speed. Text files travel compressed: Brotli where the server has it (smaller), gzip
# otherwise, and each browser gets one it understands. And the browser keeps what it has
# already downloaded, so a second page or a second visit doesn't fetch it again:
# - pictures (the hero frames too) and fonts: a year. If one ever changes, give it a new file
#   name, or returning visitors keep the old one.
# - styles and scripts (.css, .js): a week. After an update, someone who visited in the last
#   week can get the new page with the old file. To make a changed file show at once, give it
#   a new name, or add ?v=2 (then 3, 4 and so on) to its link in the pages.
# - pages (.html), robots.txt and the sitemap: the browser asks each time whether its copy is
#   still current (a tiny "not changed" when it is), so a new page shows at once.
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml text/plain
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml text/plain
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(webp|avif|png|jpe?g|gif|ico|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>
