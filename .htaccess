# Webessy Studios: settings for the web server at Hostinger (it reads this file).

# Always the secure address. A visit to an http:// address is sent on, for good (301), to the
# same page at https://, so every page and form travels encrypted. The second condition stops a
# loop if a CDN or proxy in front of the server has already taken the visit over https.
# No HSTS yet, on purpose.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# A page that doesn't exist shows our own 404 page, and still answers "404 Not Found".
ErrorDocument 404 /404.html

# The working notes (RATES.md and the other .md files) and the .zip files never belong
# online. If one is uploaded by mistake, the server answers "not found" instead of showing it.
<IfModule mod_alias.c>
  RedirectMatch 404 (?i)\.(md|zip)$
</IfModule>

# Speed. Text files travel compressed. And the browser keeps what it has already downloaded,
# so a second page or a second visit doesn't fetch it again: fonts for a year, pictures (the
# hero frames too) for a month. If a font or a picture ever changes, give it a new file name.
# The pages, the styles and the scripts change with every update, so for those the browser asks
# each time whether its copy is still current (a tiny "not changed" when it is), and nobody sees
# a new page with an old stylesheet.
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml text/plain
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpg|ico|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
