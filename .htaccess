# Webessy Studios: settings for the web server at Hostinger (it reads this file).

# Always the secure address. A visit to an http:// address is sent on, for good (301), to the
# same page at https://, so every page and form travels encrypted. The second condition stops a
# loop if a CDN or proxy in front of the server has already taken the visit over https.
# No HSTS yet, on purpose.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# A page that doesn't exist shows our own 404 page, and still answers "404 Not Found".
ErrorDocument 404 /404.html

# The working notes (RATES.md and the other .md files) and the .zip files never belong
# online. If one is uploaded by mistake, the server answers "not found" instead of showing it.
<IfModule mod_alias.c>
  RedirectMatch 404 (?i)\.(md|zip)$
</IfModule>
